# gmessages-rag environment configuration

# Postgres Configuration
POSTGRES_USER=rcsrag
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gmessages
DATABASE_URL=postgres://rcsrag:changeme@db:5432/gmessages?sslmode=disable
TZ=America/Chicago

# Daemon Web & MCP Server
HTTP_PORT=8090
HOST_PORT=8090
DATA_DIR=./data
PUID=1000
PGID=1000

# OpenAI-Compatible API Config (OpenRouter, OpenAI, LiteLLM, Ollama)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_llm_api_key_here
DOSSIER_MODEL=anthropic/claude-3.7-sonnet
SUMMARY_MODEL=google/gemini-2.5-flash
VISION_MODEL=google/gemini-2.5-flash

# Embeddings API Config
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Pipeline Tuning
TRACKED_CONTACTS=
SESSION_GAP_HOURS=2
DOSSIER_DEBOUNCE_MINUTES=30
MAX_BACKFILL_MESSAGES=5000
ENABLE_MCP_SEND_MESSAGE=false
MCP_ACCESS_TOKEN=
WEBHOOK_URL=

# Connection Scheduling (SYNC-01)
# continuous = stay connected (real-time); periodic = connect only during each window.
SYNC_MODE=periodic
SYNC_INTERVAL_MINUTES=30
SYNC_WINDOW_MINUTES=5
GM_PING_INTERVAL_MINUTES=5
GM_ALERT_TIMEOUT_COUNT=2

# Apprise & ntfy Push Notifications (Re-Auth & Alerts)
APPRISE_URL=
NTFY_URL=
EXTERNAL_WEB_URL=http://localhost:8090
NOTIFY_ON_PHONE_DISCONNECT=false
PHONE_DISCONNECT_GRACE_MINUTES=15

# Ingestion Heuristics & Media Options
ENABLE_READ_RECEIPT_HEURISTIC=true
PULL_FULL_SIZE_MEDIA=false
SYNC_GOOGLE_CONTACTS=true

